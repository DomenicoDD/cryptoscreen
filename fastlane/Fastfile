default_platform(:ios)

platform :ios do
  desc "Upload App Store metadata only. Screenshots are intentionally skipped."
  lane :metadata do
    deliver(
      app_identifier: "com.domenico.privacyscreen",
      app: 6779173642,
      app_version: "1.0",
      metadata_path: "fastlane/metadata",
      screenshots_path: "fastlane/screenshots",
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      force: true
    )
  end

  desc "Upload App Privacy answers after Apple ID authentication is available."
  lane :privacy do
    upload_app_privacy_details_to_app_store(
      app_identifier: "com.domenico.privacyscreen",
      team_id: "J7C56736F3",
      json_path: "fastlane/app_privacy_details.json"
    )
  end
end
